{
  "expo": {
    "name": "TontineClub",
    "slug": "tontineclub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tontineclub",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tontineclub.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Prendre votre photo de profil",
        "NSPhotoLibraryUsageDescription": "Choisir votre photo de profil"
      }
    },
    "android": {
      "package": "com.tontineclub.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir votre photo de profil",
          "cameraPermission": "Prendre votre photo de profil"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "edbf1fbc-7e86-4bfc-897d-eeef9d2b73a"
      }
    },
    "owner": "tontineclub",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
